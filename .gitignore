!backend/uploads/.gitkeep
docs/enviar/
backups/
*.xlsx
*.sql.gz
.claude/settings.local.json
API_LEADS.pdf
# Los PDF de la doc se generan desde el .html (chromium --print-to-pdf)
docs/*.pdf
*.log
.DS_Store
.env
.worktrees/
backend/.env
backend/node_modules/
backend/uploads/*
# Excepción: las fotos del catálogo comercial sí se versionan. El disco de
# Railway es efímero (se borra en cada deploy), y así viajan con el código y
# quedan respaldadas. Lo que sube el equipo (documentos legales, planos) sigue
# fuera del repo: eso son datos de clientes.
!backend/uploads/catalogo/
frontend/.env
frontend/dist/
frontend/node_modules/
node_modules/
tools/emailmasivo/.env
tools/emailmasivo/node_modules/
.claude/skills/
__pycache__/
