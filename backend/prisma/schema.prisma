generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────

enum Rol {
  GERENTE
  JEFE_VENTAS
  VENDEDOR
  BROKER_EXTERNO
  ABOGADO
}

enum TipoUnidad {
  BODEGA
  ESTACIONAMIENTO
}

enum SubtipoEstacionamiento {
  NORMAL
  TANDEM
}

enum AccesoUnidad {
  NIVEL
  SUBTERRANEO
}

enum EstadoUnidad {
  DISPONIBLE
  RESERVADO
  VENDIDO
  ARRENDADO
}

enum EtapaLead {
  NUEVO
  REACTIVADO
  NO_CONTESTA
  SEGUIMIENTO
  COTIZACION_ENVIADA
  INTERESADO
  VISITA_AGENDADA
  VISITA_REALIZADA
  SEGUIMIENTO_POST_VISITA
  NEGOCIACION
  RESERVA
  PROMESA
  ESCRITURA
  ENTREGA
  POSTVENTA
  PERDIDO
}

enum OrigenLead {
  INSTAGRAM
  GOOGLE
  REFERIDO
  BROKER
  VISITA_DIRECTA
  WEB
  META
  ORIGEN
  OTRO
}

// Interaccion quedó solo para Notas tras separar Actividad (jun 2026)
enum TipoInteraccion {
  NOTA
}

enum TipoActividad {
  REUNION_COMERCIAL
  LLAMADA
  WHATSAPP
  EMAIL
  OTRO
}

// Los nombres coinciden con los valores ya almacenados para no migrar datos
// ni tocar el frontend (solo se acota a valores válidos).
enum TipoVisita {
  presencial
  virtual
  reunion_comercial @map("Reunión comercial")
}

enum DireccionEmail {
  ENVIADO
  RECIBIDO
}

enum PrioridadPostventa {
  baja
  media
  alta
}

enum TipoMovimientoLlave {
  prestamo
  devolucion
}

enum EstadoVenta {
  RESERVA
  PROMESA
  ESCRITURA
  ENTREGADO
  ANULADO
}

enum EstadoLegal {
  CONFECCION_PROMESA
  FIRMA_CLIENTE_PROMESA
  FIRMA_INMOBILIARIA_PROMESA
  CONFECCION_ESCRITURA
  FIRMA_CLIENTE_ESCRITURA
  FIRMA_INMOBILIARIA_ESCRITURA
  INSCRIPCION_CBR
  ENTREGADO
}

enum TipoPersona {
  NATURAL
  EMPRESA
  SOCIEDAD
}

// Semáforo del resumen legal recibido desde el proceso externo (bot de emails)
enum SemaforoLegal {
  AL_DIA
  ATENCION
  ATRASADO
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  ATRASADO
  CONDONADO
}

enum MetodoPago {
  TRANSFERENCIA
  VALE_VISTA
  TARJETA
  CHEQUE
  EFECTIVO
}

enum TipoCuota {
  RESERVA
  PIE
  CUOTA
  ESCRITURA
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
}

enum EstadoSolicitudDescuento {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum EstadoArriendo {
  ACTIVO
  TERMINADO
}

enum EstadoLlave {
  EN_OFICINA
  PRESTADA
  PERDIDA
}

enum TipoPostventa {
  RECLAMO
  CONSULTA
  TRAMITE
  GARANTIA
}

enum EstadoPostventa {
  ABIERTO
  EN_PROCESO
  CERRADO
}

enum TipoAlerta {
  LLAVE_NO_DEVUELTA
  CUOTA_VENCIDA
  LEAD_SIN_ACTIVIDAD
  LEAD_ESTANCADO
  FECHA_LEGAL_PROXIMA
  ARRIENDO_POR_VENCER
  DESCUENTO_PENDIENTE
  LEAD_ETAPA_CAMBIO
  LEAD_NUEVO
  RECORDATORIO_LEAD
  COMISION_ESCRITURA
  EMAIL_RECIBIDO
  ACTIVIDAD_EN_LEAD
  VISITA_PROXIMA
  DESCUENTO_RESUELTO
  MENCION_NOTA
  RESPUESTA_NOTA
  REACCION_NOTA
}

enum TipoPack {
  COMBO_ESPECIFICO
  POR_CANTIDAD
}

enum TipoBeneficio {
  ARRIENDO_ASEGURADO
  GASTOS_NOTARIALES
  CUOTAS_SIN_INTERES
  OTRO
}

enum EstadoBeneficio {
  PENDIENTE
  EN_CURSO
  COMPLETADO
  CANCELADO
}

// Promociones unificadas (reemplazan progresivamente a Pack + Beneficio)
enum CategoriaPromocion {
  DESCUENTO // afecta el precio (resta del total)
  BENEFICIO // NO afecta el precio (regalo / condición)
}

enum TipoPromocion {
  // Categoría DESCUENTO
  DESCUENTO_UF
  DESCUENTO_PORCENTAJE
  PAQUETE
  // Categoría BENEFICIO
  BENEFICIO
  ARRIENDO_ASEGURADO
  GASTOS_NOTARIALES
  CUOTAS_SIN_INTERES
  OTRO
}

// ─── MODELOS ──────────────────────────────────────────────────

model Usuario {
  id                      Int      @id @default(autoincrement())
  nombre                  String
  apellido                String
  email                   String   @unique
  password                String
  telefono                String?
  smtpEmail               String?
  smtpPassword            String?
  firma                   String?
  plantillaEmail          String?
  plantillaCotizacion     String?
  rol                     Rol
  comisionPorcentaje      Float?
  comisionFijo            Decimal? @db.Decimal(18, 6)
  activo                  Boolean  @default(true)
  notificacionesActivas   Boolean  @default(true)
  notificacionesEmail     Boolean  @default(true)
  modulosVisibles         String[] @default([])
  campanasFiltro          String[] @default([])
  edificiosFiltro         Int[]    @default([])
  leadsIndividualesFiltro Int[]    @default([])
  creadoEn                DateTime @default(now())
  actualizadoEn           DateTime @updatedAt

  leadsAsignados          Lead[]                  @relation("VendedorLead")
  leadsComoBroker         Lead[]                  @relation("BrokerLead")
  visitasRealizadas       Visita[]
  interacciones           Interaccion[]
  actividades             Actividad[]
  reaccionesNota          ReaccionNota[]
  respuestasNota          RespuestaNota[]
  ventasComoVendedor      Venta[]                 @relation("VendedorVenta")
  ventasComoBroker        Venta[]                 @relation("BrokerVenta")
  ventasComoGerente       Venta[]                 @relation("GerenteVenta")
  comisiones              Comision[]
  llavesResponsable       MovimientoLlave[]
  notificaciones          Notificacion[]
  postventas              Postventa[]
  documentosLegales       DocumentoLegal[]
  cotizaciones            Cotizacion[]
  solicitudesHechas       SolicitudDescuento[]    @relation("SolicitudesHechas")
  solicitudesRevisadas    SolicitudDescuento[]    @relation("SolicitudesRevisadas")
  recordatoriosCreadosPor Recordatorio[]          @relation("RecordatoriosCreadosPor")
  emailConversaciones     EmailConversacion[]
  reportesDiarios         ReporteDiario[]
  reportesSemanales       ReporteSemanal[]
  emailsFavoritos         EmailFavorito[]
  cambiosPrecio           HistorialPrecioUnidad[]
  reglasComision          ReglaComision[]
  arriendosComoVendedor   Arriendo[]              @relation("VendedorArriendo")
  cambiosLegales          HistorialLegal[]

  @@map("usuarios")
}

model Edificio {
  id                   Int      @id @default(autoincrement())
  nombre               String
  direccion            String
  region               String
  comuna               String
  inmobiliaria         String?
  contactoInmobiliaria String?
  descripcion          String?
  activo               Boolean  @default(true)
  creadoEn             DateTime @default(now())
  actualizadoEn        DateTime @updatedAt

  unidades Unidad[]
  visitas  Visita[]

  @@map("edificios")
}

model Unidad {
  id             Int                     @id @default(autoincrement())
  edificioId     Int
  tipo           TipoUnidad
  subtipo        SubtipoEstacionamiento?
  numero         String
  piso           String?
  m2             Float?
  techado        Boolean?
  acceso         AccesoUnidad?
  precioUF       Decimal                 @db.Decimal(18, 6)
  precioMinimoUF Decimal?                @db.Decimal(18, 6)
  precioCostoUF  Decimal?                @db.Decimal(18, 6)
  estado         EstadoUnidad            @default(DISPONIBLE)
  notas          String?
  creadoEn       DateTime                @default(now())
  actualizadoEn  DateTime                @updatedAt

  ventaId Int?
  venta   Venta? @relation(fields: [ventaId], references: [id])

  edificio         Edificio                @relation(fields: [edificioId], references: [id])
  archivos         Archivo[]
  llaves           Llave[]
  leads            Lead[]
  arriendos        Arriendo[]
  cotizacionItems  CotizacionItem[]
  packs            UnidadPack[]
  beneficios       UnidadBeneficio[]
  promociones      UnidadPromocion[]
  historialPrecios HistorialPrecioUnidad[]

  @@unique([edificioId, numero])
  @@index([ventaId])
  @@index([estado])
  @@map("unidades")
}

model HistorialPrecioUnidad {
  id               Int      @id @default(autoincrement())
  unidadId         Int
  unidad           Unidad   @relation(fields: [unidadId], references: [id])
  precioAnteriorUF Decimal? @db.Decimal(18, 6)
  precioNuevoUF    Decimal  @db.Decimal(18, 6)
  motivo           String?
  usuarioId        Int?
  usuario          Usuario? @relation(fields: [usuarioId], references: [id])
  creadoEn         DateTime @default(now())

  @@index([unidadId])
  @@index([usuarioId])
  @@index([creadoEn])
  @@map("historial_precios_unidad")
}

model Archivo {
  id       Int      @id @default(autoincrement())
  unidadId Int
  url      String
  nombre   String
  tipo     String
  creadoEn DateTime @default(now())

  unidad Unidad @relation(fields: [unidadId], references: [id])

  @@index([unidadId])
  @@map("archivos")
}

model Contacto {
  id                  Int         @id @default(autoincrement())
  nombre              String
  apellido            String
  rut                 String?     @unique
  email               String?
  telefono            String?
  empresa             String?
  tipoPersona         TipoPersona @default(NATURAL)
  origen              OrigenLead  @default(OTRO)
  notas               String?
  fechaNacimiento     DateTime?
  ciudadNacimiento    String?
  estadoCivil         String?
  profesion           String?
  nacionalidad        String?
  regimenMatrimonial  String?
  direccionParticular String?
  creadoEn            DateTime    @default(now())
  actualizadoEn       DateTime    @updatedAt

  leads     Lead[]
  compras   Venta[]    @relation("CompradorVenta")
  arriendos Arriendo[]

  @@index([email])
  @@map("contactos")
}

model Lead {
  id                  Int        @id @default(autoincrement())
  contactoId          Int
  unidadInteresId     Int?
  vendedorId          Int?
  brokerId            Int?
  etapa               EtapaLead  @default(NUEVO)
  campana             String? // texto original (legacy); campanaId es el vínculo al catálogo
  campanaId           Int?
  presupuestoAprox    Decimal?   @db.Decimal(18, 6)
  motivoPerdida       String?
  etapaAntesDePerdido EtapaLead?
  motivoPerdidaCat    String?
  motivoPerdidaNota   String?
  perdidaAutomatica   Boolean    @default(false)
  perdidaAutomaticaEn DateTime?
  notas               String?
  comuroData          Json?
  comuroUuid          String?    @unique
  comuroThreadId      String?
  creadoEn            DateTime   @default(now())
  actualizadoEn       DateTime   @updatedAt

  contacto            Contacto            @relation(fields: [contactoId], references: [id])
  campanaRef          Campana?            @relation(fields: [campanaId], references: [id])
  unidadInteres       Unidad?             @relation(fields: [unidadInteresId], references: [id])
  vendedor            Usuario?            @relation("VendedorLead", fields: [vendedorId], references: [id])
  broker              Usuario?            @relation("BrokerLead", fields: [brokerId], references: [id])
  visitas             Visita[]
  interacciones       Interaccion[]
  actividades         Actividad[]
  ventas              Venta[]
  cotizaciones        Cotizacion[]
  recordatorios       Recordatorio[]
  emailConversaciones EmailConversacion[]

  @@index([contactoId])
  @@index([campanaId])
  @@index([unidadInteresId])
  @@index([vendedorId])
  @@index([brokerId])
  @@index([etapa])
  @@map("leads")
}

model Visita {
  id         Int      @id @default(autoincrement())
  leadId     Int
  vendedorId Int?
  edificioId Int?
  fechaHora  DateTime
  tipo       TipoVisita
  resultado  String?
  notas      String?
  enlace     String? // link de la reunión online (Meet/Zoom) cuando es virtual
  creadoEn   DateTime @default(now())

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vendedor Usuario?  @relation(fields: [vendedorId], references: [id])
  edificio Edificio? @relation(fields: [edificioId], references: [id])

  @@index([leadId])
  @@index([vendedorId])
  @@index([edificioId])
  @@index([fechaHora])
  @@map("visitas")
}

model Interaccion {
  id          Int             @id @default(autoincrement())
  leadId      Int
  usuarioId   Int?
  tipo        TipoInteraccion
  descripcion String
  fecha       DateTime        @default(now())

  lead       Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  usuario    Usuario?        @relation(fields: [usuarioId], references: [id])
  reacciones ReaccionNota[]
  respuestas RespuestaNota[]

  @@index([leadId])
  @@index([usuarioId])
  @@index([fecha])
  @@map("interacciones")
}

// Reacción (emoji) a una nota. Un usuario puede reaccionar con varios emojis
// distintos, pero no repetir el mismo emoji en la misma nota.
model ReaccionNota {
  id            Int      @id @default(autoincrement())
  interaccionId Int
  usuarioId     Int
  emoji         String
  creadoEn      DateTime @default(now())

  interaccion Interaccion @relation(fields: [interaccionId], references: [id], onDelete: Cascade)
  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([interaccionId, usuarioId, emoji])
  @@index([interaccionId])
  @@map("reacciones_nota")
}

// Respuesta a una nota (comentario anidado). Soporta @menciones igual que las notas.
model RespuestaNota {
  id            Int      @id @default(autoincrement())
  interaccionId Int
  usuarioId     Int?
  descripcion   String
  fecha         DateTime @default(now())

  interaccion Interaccion @relation(fields: [interaccionId], references: [id], onDelete: Cascade)
  usuario     Usuario?    @relation(fields: [usuarioId], references: [id])

  @@index([interaccionId])
  @@map("respuestas_nota")
}

model Actividad {
  id          Int           @id @default(autoincrement())
  leadId      Int
  usuarioId   Int?
  tipo        TipoActividad
  descripcion String
  fecha       DateTime      @default(now()) // puede ser futura → aparece en el calendario
  resultado   String?
  creadoEn    DateTime      @default(now())

  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([leadId])
  @@index([usuarioId])
  @@index([fecha])
  @@map("actividades")
}

model Venta {
  id                 Int  @id @default(autoincrement())
  leadId             Int
  compradorId        Int
  vendedorId         Int?
  brokerId           Int?
  gerenteId          Int?
  cotizacionOrigenId Int  @unique

  precioListaUF       Decimal @default(0) @db.Decimal(18, 6)
  descuentoPacksUF    Decimal @default(0) @db.Decimal(18, 6)
  descuentoAprobadoUF Decimal @default(0) @db.Decimal(18, 6)
  precioFinalUF       Decimal @default(0) @db.Decimal(18, 6)

  estado         EstadoVenta @default(RESERVA)
  fechaReserva   DateTime?
  fechaPromesa   DateTime?
  fechaEscritura DateTime?
  fechaEntrega   DateTime?
  notas          String?
  conPromesa     Boolean     @default(true)
  creadoEn       DateTime    @default(now())
  actualizadoEn  DateTime    @updatedAt

  lead             Lead             @relation(fields: [leadId], references: [id])
  unidades         Unidad[]
  comprador        Contacto         @relation("CompradorVenta", fields: [compradorId], references: [id])
  vendedor         Usuario?         @relation("VendedorVenta", fields: [vendedorId], references: [id])
  broker           Usuario?         @relation("BrokerVenta", fields: [brokerId], references: [id])
  gerente          Usuario?         @relation("GerenteVenta", fields: [gerenteId], references: [id])
  cotizacionOrigen Cotizacion       @relation(fields: [cotizacionOrigenId], references: [id])
  planPago         PlanPago?
  procesoLegal     ProcesoLegal?
  comisiones       Comision[]
  beneficios       VentaBeneficio[]
  promociones      VentaPromocion[]
  postventa        Postventa[]
  resumenesLegales ResumenLegal[]

  @@index([leadId])
  @@index([compradorId])
  @@index([vendedorId])
  @@index([brokerId])
  @@index([gerenteId])
  @@index([estado])
  @@map("ventas")
}

// Resumen de la situación legal de una venta, generado por un proceso EXTERNO
// (lee correos de notaría/inmobiliaria/CBR y resume). El CRM solo recibe y guarda.
// Historial: una fila por cada resumen recibido → se ve la evolución en el tiempo.
model ResumenLegal {
  id            Int            @id @default(autoincrement())
  ventaId       Int
  resumen       String         @db.Text
  semaforo      SemaforoLegal?
  proximaAccion String?
  fuente        String? // origen del resumen (ej: "email-bot")
  creadoEn      DateTime       @default(now())

  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@index([ventaId])
  @@index([creadoEn])
  @@map("resumenes_legales")
}

model ProcesoLegal {
  id                             Int         @id @default(autoincrement())
  ventaId                        Int         @unique
  tienePromesa                   Boolean     @default(true)
  estadoActual                   EstadoLegal @default(CONFECCION_PROMESA)
  fechaLimiteConfeccionPromesa   DateTime?
  fechaLimiteFirmaCliente        DateTime?
  fechaLimiteFirmaInmob          DateTime?
  fechaLimiteEscritura           DateTime?
  fechaLimiteFirmaNot            DateTime?
  fechaLimiteFirmaInmobEscritura DateTime?
  fechaLimiteCBR                 DateTime?
  fechaLimiteEntrega             DateTime?
  notas                          String?
  creadoEn                       DateTime    @default(now())
  actualizadoEn                  DateTime    @updatedAt

  venta      Venta            @relation(fields: [ventaId], references: [id])
  documentos DocumentoLegal[]
  historial  HistorialLegal[]

  @@map("procesos_legales")
}

// Registro automático de cada cambio de paso legal (fecha real + quién lo movió)
model HistorialLegal {
  id             Int         @id @default(autoincrement())
  procesoLegalId Int
  paso           EstadoLegal
  usuarioId      Int?
  creadoEn       DateTime    @default(now())

  procesoLegal ProcesoLegal @relation(fields: [procesoLegalId], references: [id])
  usuario      Usuario?     @relation(fields: [usuarioId], references: [id])

  @@index([procesoLegalId])
  @@map("historial_legal")
}

model DocumentoLegal {
  id             Int         @id @default(autoincrement())
  procesoLegalId Int
  subioPorId     Int?
  nombre         String
  url            String
  etapa          EstadoLegal
  creadoEn       DateTime    @default(now())

  procesoLegal ProcesoLegal @relation(fields: [procesoLegalId], references: [id], onDelete: Cascade)
  subidoPor    Usuario?     @relation(fields: [subioPorId], references: [id])

  @@index([procesoLegalId])
  @@index([subioPorId])
  @@map("documentos_legales")
}

model PlanPago {
  id          Int      @id @default(autoincrement())
  ventaId     Int      @unique
  totalCuotas Int
  montoUF     Decimal? @db.Decimal(18, 6)
  fechaInicio DateTime
  creadoEn    DateTime @default(now())

  venta  Venta   @relation(fields: [ventaId], references: [id])
  cuotas Cuota[]

  @@map("planes_pago")
}
// (ventaId ya está indexado por @unique)

model Cuota {
  id                Int         @id @default(autoincrement())
  planPagoId        Int
  numeroCuota       Int
  tipo              TipoCuota
  montoUF           Decimal?    @db.Decimal(18, 6)
  montoCLP          Decimal?    @db.Decimal(18, 2)
  fechaVencimiento  DateTime
  fechaPagoReal     DateTime?
  estado            EstadoPago  @default(PENDIENTE)
  metodoPago        MetodoPago?
  numeroComprobante String?
  archivoUrl        String?
  notas             String?
  creadoEn          DateTime    @default(now())
  actualizadoEn     DateTime    @updatedAt

  planPago PlanPago @relation(fields: [planPagoId], references: [id], onDelete: Cascade)

  @@index([planPagoId])
  @@index([estado])
  @@map("cuotas")
}

model Comision {
  id               Int        @id @default(autoincrement())
  ventaId          Int? // comisión de venta…
  arriendoId       Int? // …o de arriendo (canon 1er mes); una de las dos
  usuarioId        Int
  concepto         String?
  porcentaje       Float?
  montoFijo        Decimal?   @db.Decimal(18, 6)
  montoCalculadoUF Decimal    @db.Decimal(18, 6)
  montoPrimera     Decimal    @db.Decimal(18, 6)
  montoSegunda     Decimal    @db.Decimal(18, 6)
  estadoPrimera    EstadoPago @default(PENDIENTE)
  estadoSegunda    EstadoPago @default(PENDIENTE)
  fechaPagoPrimera DateTime?
  fechaPagoSegunda DateTime?
  notas            String?
  creadoEn         DateTime   @default(now())
  actualizadoEn    DateTime   @updatedAt

  venta    Venta?    @relation(fields: [ventaId], references: [id])
  arriendo Arriendo? @relation(fields: [arriendoId], references: [id])
  usuario  Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([ventaId])
  @@index([arriendoId])
  @@index([usuarioId])
  @@map("comisiones")
}

model PlantillaComision {
  id           Int      @id @default(autoincrement())
  nombre       String
  concepto     String
  porcentaje   Float?
  montoFijo    Decimal? @db.Decimal(18, 6)
  pctPromesa   Float    @default(50)
  pctEscritura Float    @default(50)
  activa       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  @@map("plantillas_comision")
}

enum AmbitoComision {
  VENDE // aplica cuando el usuario/rol es el vendedor de la venta
  VENTAS_DE_OTROS // aplica a ventas donde el usuario NO es el vendedor (ej: jefe 1%)
  TODAS // aplica a toda venta que cumpla el filtro de origen (ej: comisión webinar)
}

enum OrigenComision {
  CUALQUIERA
  SOLO_WEBINAR
  NO_WEBINAR
}

// Reglas de comisión automáticas: al convertir cotización en venta se evalúan
// y generan las Comision. Regla por usuarioId tiene prioridad sobre regla por rol.
model ReglaComision {
  id            Int            @id @default(autoincrement())
  nombre        String
  usuarioId     Int? // regla específica de un usuario (prioridad sobre rol)
  rol           Rol? // regla genérica por rol
  ambito        AmbitoComision
  origen        OrigenComision @default(CUALQUIERA)
  porcentaje    Float
  pctPromesa    Float          @default(50)
  pctEscritura  Float          @default(50)
  activa        Boolean        @default(true)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("reglas_comision")
}

model Cotizacion {
  id                  Int              @id @default(autoincrement())
  leadId              Int
  creadoPorId         Int
  estado              EstadoCotizacion @default(BORRADOR)
  validezDias         Int              @default(7)
  descuentoAprobadoUF Decimal          @default(0) @db.Decimal(18, 6)
  notas               String?
  creadoEn            DateTime         @default(now())
  actualizadoEn       DateTime         @updatedAt

  lead                 Lead                  @relation(fields: [leadId], references: [id])
  creadoPor            Usuario               @relation(fields: [creadoPorId], references: [id])
  items                CotizacionItem[]
  packs                CotizacionPack[]
  beneficios           CotizacionBeneficio[]
  promociones          CotizacionPromocion[]
  solicitudesDescuento SolicitudDescuento[]
  ventaOrigen          Venta?

  @@index([leadId])
  @@index([creadoPorId])
  @@index([estado])
  @@map("cotizaciones")
}

model CotizacionItem {
  id            Int   @id @default(autoincrement())
  cotizacionId  Int
  unidadId      Int
  precioListaUF Decimal @db.Decimal(18, 6)
  descuentoUF   Decimal @default(0) @db.Decimal(18, 6) // descuento por unidad (snapshot) → habilita precio tachado

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  unidad     Unidad     @relation(fields: [unidadId], references: [id])

  @@unique([cotizacionId, unidadId])
  @@index([unidadId])
  @@map("cotizacion_items")
}

model Pack {
  id          Int       @id @default(autoincrement())
  nombre      String
  descripcion String?
  tipo        TipoPack
  descuentoUF Decimal   @db.Decimal(18, 6)
  minUnidades Int       @default(2)
  fechaInicio DateTime?
  fechaFin    DateTime?
  activa      Boolean   @default(true)
  creadoEn    DateTime  @default(now())

  unidades     UnidadPack[]
  cotizaciones CotizacionPack[]

  @@map("packs")
}

model UnidadPack {
  unidadId Int
  packId   Int
  unidad   Unidad @relation(fields: [unidadId], references: [id])
  pack     Pack   @relation(fields: [packId], references: [id])

  @@id([unidadId, packId])
  @@index([packId])
  @@map("unidades_packs")
}

model CotizacionPack {
  id                  Int   @id @default(autoincrement())
  cotizacionId        Int
  packId              Int
  descuentoAplicadoUF Decimal @db.Decimal(18, 6)

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  pack       Pack       @relation(fields: [packId], references: [id])

  @@unique([cotizacionId, packId])
  @@index([packId])
  @@map("cotizacion_packs")
}

model Beneficio {
  id             Int           @id @default(autoincrement())
  nombre         String
  descripcion    String?
  tipo           TipoBeneficio
  meses          Int?
  montoMensualUF Decimal?      @db.Decimal(18, 6)
  detalle        String?
  fechaInicio    DateTime?
  fechaFin       DateTime?
  activa         Boolean       @default(true)
  creadoEn       DateTime      @default(now())

  unidades     UnidadBeneficio[]
  cotizaciones CotizacionBeneficio[]
  ventas       VentaBeneficio[]

  @@map("beneficios")
}

model UnidadBeneficio {
  unidadId    Int
  beneficioId Int
  unidad      Unidad    @relation(fields: [unidadId], references: [id])
  beneficio   Beneficio @relation(fields: [beneficioId], references: [id])

  @@id([unidadId, beneficioId])
  @@index([beneficioId])
  @@map("unidades_beneficios")
}

model CotizacionBeneficio {
  cotizacionId Int
  beneficioId  Int

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  beneficio  Beneficio  @relation(fields: [beneficioId], references: [id])

  @@id([cotizacionId, beneficioId])
  @@index([beneficioId])
  @@map("cotizacion_beneficios")
}

model VentaBeneficio {
  id          Int             @id @default(autoincrement())
  ventaId     Int
  beneficioId Int
  estado      EstadoBeneficio @default(PENDIENTE)
  notas       String?
  creadoEn    DateTime        @default(now())

  venta     Venta     @relation(fields: [ventaId], references: [id])
  beneficio Beneficio @relation(fields: [beneficioId], references: [id])

  @@unique([ventaId, beneficioId])
  @@index([beneficioId])
  @@map("ventas_beneficios")
}

// ─── PROMOCIONES (modelo unificado: descuentos + beneficios) ──────

model Campana {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  descripcion String?
  esWebinar   Boolean   @default(false) // ventas de esta campaña comisionan como webinar
  fechaInicio DateTime?
  fechaFin    DateTime?
  activa      Boolean   @default(true)
  creadoEn    DateTime  @default(now())

  promociones Promocion[]
  leads       Lead[]

  @@map("campanas")
}

model Promocion {
  id              Int                @id @default(autoincrement())
  nombre          String
  descripcion     String?
  categoria       CategoriaPromocion // DESCUENTO (afecta precio) | BENEFICIO (no afecta)
  tipo            TipoPromocion
  valorUF         Decimal? @db.Decimal(18, 6) // DESCUENTO_UF / PAQUETE (precio del pack)
  valorPorcentaje Float? // DESCUENTO_PORCENTAJE
  precioObjetivoPesos Decimal? @db.Decimal(18, 2) // precio final por unidad en $ (el descuento UF se calcula dinámico con la UF vigente → peso exacto)
  minUnidades     Int? // mínimo de unidades en la cotización (volumen)
  meses           Int? // ARRIENDO_ASEGURADO / CUOTAS_SIN_INTERES
  montoMensualUF  Decimal? @db.Decimal(18, 6) // ARRIENDO_ASEGURADO
  detalle         String?
  fechaInicio     DateTime?
  fechaFin        DateTime?
  activa          Boolean            @default(true)
  campanaId       Int? // null = permanente / sin campaña
  creadoEn        DateTime           @default(now())

  campana      Campana?              @relation(fields: [campanaId], references: [id])
  unidades     UnidadPromocion[]
  cotizaciones CotizacionPromocion[]
  ventas       VentaPromocion[]

  @@index([categoria])
  @@index([campanaId])
  @@map("promociones")
}

model UnidadPromocion {
  unidadId    Int
  promocionId Int
  unidad      Unidad    @relation(fields: [unidadId], references: [id])
  promocion   Promocion @relation(fields: [promocionId], references: [id], onDelete: Cascade)

  @@id([unidadId, promocionId])
  @@index([promocionId])
  @@map("unidades_promociones")
}

model CotizacionPromocion {
  id                  Int   @id @default(autoincrement())
  cotizacionId        Int
  promocionId         Int
  descuentoAplicadoUF Decimal @default(0) @db.Decimal(18, 6) // 0 para beneficios

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  promocion  Promocion  @relation(fields: [promocionId], references: [id])

  @@unique([cotizacionId, promocionId])
  @@index([promocionId])
  @@map("cotizacion_promociones")
}

model VentaPromocion {
  id                  Int                @id @default(autoincrement())
  ventaId             Int
  promocionId         Int
  categoria           CategoriaPromocion
  descuentoAplicadoUF Decimal            @default(0) @db.Decimal(18, 6)
  estado              EstadoBeneficio    @default(PENDIENTE) // seguimiento (relevante para beneficios)
  notas               String?
  creadoEn            DateTime           @default(now())

  venta     Venta     @relation(fields: [ventaId], references: [id])
  promocion Promocion @relation(fields: [promocionId], references: [id])

  @@unique([ventaId, promocionId])
  @@index([promocionId])
  @@map("venta_promociones")
}

model Arriendo {
  id             Int            @id @default(autoincrement())
  unidadId       Int
  contactoId     Int
  vendedorId     Int? // quien cerró el arriendo — comisiona el canon del 1er mes
  gestorNombre   String?
  montoMensualUF Decimal?       @db.Decimal(18, 6)
  fechaInicio    DateTime
  fechaFin       DateTime?
  estado         EstadoArriendo @default(ACTIVO)
  contratoUrl    String?
  notas          String?
  creadoEn       DateTime       @default(now())
  actualizadoEn  DateTime       @updatedAt

  unidad     Unidad         @relation(fields: [unidadId], references: [id])
  contacto   Contacto       @relation(fields: [contactoId], references: [id])
  vendedor   Usuario?       @relation("VendedorArriendo", fields: [vendedorId], references: [id])
  pagos      PagoArriendo[]
  comisiones Comision[]

  @@index([unidadId])
  @@index([contactoId])
  @@index([vendedorId])
  @@map("arriendos")
}

model PagoArriendo {
  id          Int        @id @default(autoincrement())
  arriendoId  Int
  mes         DateTime   @db.Date // primer día del mes facturado
  montoUF     Decimal?   @db.Decimal(18, 6)
  montoCLP    Decimal?   @db.Decimal(18, 2)
  estado      EstadoPago @default(PENDIENTE)
  fechaPago   DateTime?
  comprobante String?
  creadoEn    DateTime   @default(now())

  arriendo Arriendo @relation(fields: [arriendoId], references: [id], onDelete: Cascade)

  @@unique([arriendoId, mes])
  @@map("pagos_arriendo")
}

model Llave {
  id            Int         @id @default(autoincrement())
  unidadId      Int
  codigo        String      @unique
  estado        EstadoLlave @default(EN_OFICINA)
  notas         String?
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt

  unidad      Unidad            @relation(fields: [unidadId], references: [id])
  movimientos MovimientoLlave[]

  @@index([unidadId])
  @@map("llaves")
}

model MovimientoLlave {
  id                      Int       @id @default(autoincrement())
  llaveId                 Int
  responsableId           Int?
  tipo                    TipoMovimientoLlave
  personaNombre           String?
  personaContacto         String?
  motivo                  String?
  fechaPrestamo           DateTime  @default(now())
  fechaDevolucionEsperada DateTime?
  fechaDevolucionReal     DateTime?
  creadoEn                DateTime  @default(now())

  llave       Llave    @relation(fields: [llaveId], references: [id], onDelete: Cascade)
  responsable Usuario? @relation(fields: [responsableId], references: [id])

  @@index([llaveId])
  @@index([responsableId])
  @@map("movimientos_llaves")
}

model Postventa {
  id            Int             @id @default(autoincrement())
  ventaId       Int
  responsableId Int?
  tipo          TipoPostventa
  descripcion   String
  estado        EstadoPostventa    @default(ABIERTO)
  prioridad     PrioridadPostventa @default(media)
  fechaApertura DateTime        @default(now())
  fechaCierre   DateTime?
  resolucion    String?
  creadoEn      DateTime        @default(now())
  actualizadoEn DateTime        @updatedAt

  venta       Venta    @relation(fields: [ventaId], references: [id])
  responsable Usuario? @relation(fields: [responsableId], references: [id])

  @@index([ventaId])
  @@index([responsableId])
  @@map("postventas")
}

model ApiKey {
  id            Int      @id @default(autoincrement())
  nombre        String
  key           String   @unique
  activa        Boolean  @default(true)
  soloEscritura Boolean  @default(false) // si true, la key no puede usar endpoints de lectura (GET). Default false = comportamiento previo.
  creadoEn      DateTime @default(now())

  @@map("api_keys")
}

// Registro de requests a los endpoints de integración externa (Comuro,
// formulario web, webinar) — diagnóstico de caídas del flujo de leads
model LogIntegracion {
  id         Int      @id @default(autoincrement())
  endpoint   String
  metodo     String
  status     Int
  apiKey     String? // nombre de la ApiKey usada (null si 401)
  ip         String?
  error      String? // body de respuesta cuando status >= 400
  payload    Json?
  duracionMs Int?
  creadoEn   DateTime @default(now())

  @@index([creadoEn])
  @@map("logs_integraciones")
}

model UFDiaria {
  fecha      DateTime @id
  valorPesos Decimal  @db.Decimal(18, 2)
  creadoEn   DateTime @default(now())

  @@map("uf_diaria")
}

model AlertaConfig {
  id               Int        @id @default(autoincrement())
  tipo             TipoAlerta @unique
  umbralDias       Int
  activa           Boolean    @default(true)
  accionAutomatica Boolean    @default(false)
  canalEmail       Boolean    @default(true)
  canalWhatsapp    Boolean    @default(false)

  @@map("alertas_config")
}

model Notificacion {
  id             Int        @id @default(autoincrement())
  usuarioId      Int
  tipo           TipoAlerta
  mensaje        String
  referenciaId   Int?
  referenciaTipo String?
  leida          Boolean    @default(false)
  creadoEn       DateTime   @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([leida])
  @@map("notificaciones")
}

model SolicitudDescuento {
  id              Int                      @id @default(autoincrement())
  cotizacionId    Int
  solicitadoPorId Int
  revisadoPorId   Int?
  tipo            String // UF | PESOS | PORCENTAJE | TOTAL_UF | TOTAL_PESOS
  valor           Decimal @db.Decimal(18, 6)
  descuentoAplicadoUF Decimal? @db.Decimal(18, 6) // UF efectivamente descontadas al aprobar
  motivo          String
  estado          EstadoSolicitudDescuento @default(PENDIENTE)
  comentario      String?
  creadoEn        DateTime                 @default(now())
  revisadoEn      DateTime?

  cotizacion    Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  solicitadoPor Usuario    @relation("SolicitudesHechas", fields: [solicitadoPorId], references: [id])
  revisadoPor   Usuario?   @relation("SolicitudesRevisadas", fields: [revisadoPorId], references: [id])

  @@index([cotizacionId])
  @@index([solicitadoPorId])
  @@index([revisadoPorId])
  @@index([estado])
  @@map("solicitudes_descuento")
}

model Recordatorio {
  id          Int      @id @default(autoincrement())
  leadId      Int
  creadoPorId Int
  descripcion String
  fechaHora   DateTime
  completado  Boolean  @default(false)
  notificado  Boolean  @default(false)
  creadoEn    DateTime @default(now())

  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  creadoPor Usuario @relation("RecordatoriosCreadosPor", fields: [creadoPorId], references: [id])

  @@index([leadId])
  @@index([creadoPorId])
  @@map("recordatorios")
}

model ReglaPipeline {
  id            Int      @id @default(autoincrement())
  nombre        String
  etapaOrigen   String
  etapaDestino  String
  umbralDias    Int      @default(7)
  activa        Boolean  @default(false)
  motivoAuto    String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("reglas_pipeline")
}

model EmailConversacion {
  id        Int       @id @default(autoincrement())
  leadId    Int
  messageId String?   @unique
  inReplyTo String?
  direction DireccionEmail
  asunto    String
  cuerpo    String    @db.Text
  de        String
  para      String
  cc        String[]  @default([])
  bcc       String[]  @default([])
  usuarioId Int?
  leido     Boolean   @default(false)
  abierto   Boolean   @default(false)
  abiertoEn DateTime?
  creadoEn  DateTime  @default(now())

  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([leadId])
  @@index([usuarioId])
  @@map("email_conversaciones")
}

model ReporteDiario {
  id         Int      @id @default(autoincrement())
  vendedorId Int
  fecha      DateTime @db.Date
  contenido  Json
  creadoEn   DateTime @default(now())

  vendedor Usuario @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  @@unique([vendedorId, fecha])
  @@index([fecha])
  @@map("reportes_diarios")
}

model ReporteSemanal {
  id          Int      @id @default(autoincrement())
  usuarioId   Int
  fechaInicio DateTime @db.Date // lunes
  fechaFin    DateTime @db.Date // domingo
  contenido   Json
  creadoEn    DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, fechaInicio])
  @@index([fechaInicio])
  @@map("reportes_semanales")
}

model EmailFavorito {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  email     String
  nombre    String?
  creadoEn  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, email])
  @@index([usuarioId])
  @@map("emails_favoritos")
}
